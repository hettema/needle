#!/usr/bin/env python3
"""A stand-in for `ssh` on the test floor (card #83): the other machine is a
second floor under the same root. The host named is looked up in
`$NEEDLE_FAKE_STATE["hosts"]`; one the test never laid answers as the real
`ssh` does for a name that resolves nowhere — exit 255 — and one it did
runs the line here under that host's own environment (its slots, its
registries, its memory, its machine id, its store), so `needle` on the
"other machine" reads and writes the other floor. `bash -lc` is run as
`bash -c`: the profile a login shell would read is this laptop's, and the
fakes are already first on PATH. Every call is recorded in `ssh_calls`."""

import fcntl
import json
import os
import subprocess
import sys
from pathlib import Path

STATE = Path(os.environ["NEEDLE_FAKE_STATE"])

UNREACHABLE = 255


def _record(entry: dict) -> dict:
    with (STATE.parent / (STATE.name + ".lock")).open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        blob = json.loads(STATE.read_text(encoding="utf-8"))
        blob.setdefault("ssh_calls", []).append(entry)
        STATE.write_text(json.dumps(blob, indent=1), encoding="utf-8")
        fcntl.flock(lock, fcntl.LOCK_UN)
    return blob


def _parse(argv: list[str]) -> tuple[str | None, list[str], bool]:
    """The host, the command words after it, and whether `-t` was asked."""
    tty = False
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "-o":
            i += 2
            continue
        if arg == "-t":
            tty = True
            i += 1
            continue
        if arg.startswith("-"):
            i += 1
            continue
        host = arg
        rest = argv[i + 1 :]
        if rest[:1] == ["--"]:
            rest = rest[1:]
        return host, rest, tty
    return None, [], tty


def main(argv: list[str]) -> int:
    host, words, tty = _parse(argv)
    blob = _record({"host": host, "words": words, "tty": tty})
    hosts = blob.get("hosts") or {}
    if host is None or host not in hosts:
        print(f"ssh: Could not resolve hostname {host}: Name or service not known", file=sys.stderr)
        return UNREACHABLE
    laid = hosts[host]
    if laid.get("down"):
        print(f"ssh: connect to host {host} port 22: Connection refused", file=sys.stderr)
        return UNREACHABLE
    env = {**os.environ, **laid.get("env", {})}
    if words[:2] == ["bash", "-lc"] and len(words) == 3:
        line = words[2]
    else:
        line = " ".join(words)
    # The one file the door reads from the other machine at registration:
    # its identity, which on the floor is the host's own variable.
    if line.strip() == "cat /etc/machine-id":
        print(env.get("NEEDLE_MACHINE_ID", ""))
        return 0
    done = subprocess.run(["bash", "-c", line], env=env, check=False)
    return done.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
