#!/usr/bin/env python3
"""A stand-in for the Codex CLI on the test floor (plan 57).

`codex exec -o ANSWER --output-schema SCHEMA resume [--skip-git-repo-check]
ID PROMPT` is the one form the runtime runs. The fake finds the rollout by id under
`$NEEDLE_CODEX_HOME/sessions`, appends the turn's events the way Codex does
(`task_started`, a tool call, `task_complete`) and follows the fate the
test scripted in `$NEEDLE_FAKE_STATE` (`codex`): it answers by writing its
last message to the `-o` file, as Codex itself does outside the sandbox;
answers with nothing; fails at once; or lingers at work until stopped. The
schema file is read and must be JSON, as Codex itself refuses one that is
not (card #73); a fate's `text` is written as given, so a test that wants
the shape scripts JSON and one that wants prose scripts prose. Every call
is logged with its argv, the id, the prompt and the schema, so a test can
read what the runtime asked for.
"""

import fcntl
import json
import os
import sys
import time
import uuid
from datetime import UTC, datetime
from pathlib import Path

STATE = Path(os.environ["NEEDLE_FAKE_STATE"])
HOME = Path(os.environ["NEEDLE_CODEX_HOME"])


def _locked(function):
    with (STATE.parent / (STATE.name + ".lock")).open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            blob = json.loads(STATE.read_text(encoding="utf-8"))
            result = function(blob)
            STATE.write_text(json.dumps(blob, indent=1), encoding="utf-8")
            return result
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def _proc_start(pid: int) -> str:
    return (Path("/proc") / str(pid) / "stat").read_text().rsplit(")", 1)[1].split()[19]


def _now() -> str:
    return datetime.now(UTC).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def _append(path: Path, kind: str, payload: dict) -> None:
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps({"timestamp": _now(), "type": kind, "payload": payload}) + "\n")


def resume(args: list[str]) -> int:
    answer = None
    schema = None
    rest: list[str] = []
    i = 0
    while i < len(args):
        if args[i] in ("-o", "--output-last-message") and i + 1 < len(args):
            answer = args[i + 1]
            i += 2
        elif args[i] == "--output-schema" and i + 1 < len(args):
            schema = args[i + 1]
            i += 2
        elif args[i].startswith("-"):
            i += 1
        else:
            rest.append(args[i])
            i += 1
    if not rest or rest[0] != "resume" or len(rest) < 3:
        print("error: usage: codex exec [-o FILE] resume ID PROMPT", file=sys.stderr)
        return 2
    session_id, prompt = rest[1], rest[2]
    if schema is not None:
        try:
            json.loads(Path(schema).read_text(encoding="utf-8"))
        except (OSError, ValueError) as error:
            print(f"Output schema file {schema} is not valid JSON: {error}", file=sys.stderr)
            return 1
    fate = _locked(lambda blob: blob["codex"].pop(0) if blob.get("codex") else {"then": "answer"})
    _locked(
        lambda blob: blob.setdefault("codex_log", []).append(
            {
                "argv": args,
                "id": session_id,
                "prompt": prompt,
                "answer": answer,
                "schema": schema,
                "fate": fate,
            }
        )
    )
    then = fate.get("then", "answer")
    if then == "fail":
        print(fate.get("stderr", "error: no session found"), file=sys.stderr)
        return 1
    print(f"OpenAI Codex v0.152.1 (fake)\nsession id: {session_id}", file=sys.stderr)
    found = sorted((HOME / "sessions").rglob(f"rollout-*-{session_id}.jsonl"))
    if not found:
        print(f"error: no session found for {session_id}", file=sys.stderr)
        return 1
    rollout = found[0]
    _append(rollout, "event_msg", {"type": "task_started", "turn_id": "fake"})
    _append(
        rollout,
        "response_item",
        {"type": "custom_tool_call", "name": "exec", "input": "await tools.exec_command({})"},
    )
    if then == "linger":
        pid = os.getpid()
        _locked(lambda blob: blob.setdefault("pids", []).append([pid, _proc_start(pid)]))
        # The floor tears a `sleep` down and nothing else; the name keeps
        # the id in argv, which is how the runtime finds a worker's process.
        os.execv("/usr/bin/sleep", [f"codex-exec-resume-{session_id}", "300"])
    time.sleep(float(fate.get("after", 0.3)))
    text = "" if then == "silent" else fate.get("text", "the answer, from the fake worker")
    _append(rollout, "event_msg", {"type": "task_complete", "turn_id": "fake"})
    if answer is not None:
        Path(answer).write_text(text, encoding="utf-8")
    print(text)
    return 0


TAKES_A_VALUE = {"-o", "--output-last-message", "--output-schema", "-c", "--config",
                 "-C", "--cd", "-m", "--model", "-s", "--sandbox", "--add-dir"}


def _first_positional(args: list[str]) -> str | None:
    i = 0
    while i < len(args):
        if args[i] in TAKES_A_VALUE:
            i += 2
        elif args[i].startswith("-"):
            i += 1
        else:
            return args[i]
    return None


def lane(args: list[str]) -> int:
    """`codex exec -s workspace-write -C <worktree> [-m M] [-c ...] <brief>`:
    a card's lane (card #63) — or, with `-o` and `--output-schema`, a cold
    reading in a fresh thread (card #87), which is a lane's launch shape
    with an answer to write. The fake records the argv whole so a test can
    read the sandbox, the writable roots, the model and the reasoning level
    the runtime asked for, then follows the scripted fate — `linger` writes
    the rollout Codex would write and stays at work, which is what a lane
    that took looks like from outside; anything else ends at once, which is
    what a lane that did not looks like. A fresh reading follows a resume's
    fates instead: `answer` writes `text` to the `-o` file after `after`
    seconds and exits, `silent` exits with nothing, `fail` exits 1, `linger`
    stays at work.
    """
    cwd = None
    model = None
    answer = None
    schema = None
    for i, arg in enumerate(args):
        if arg in ("-C", "--cd") and i + 1 < len(args):
            cwd = args[i + 1]
        elif arg in ("-m", "--model") and i + 1 < len(args):
            model = args[i + 1]
        elif arg in ("-o", "--output-last-message") and i + 1 < len(args):
            answer = args[i + 1]
        elif arg == "--output-schema" and i + 1 < len(args):
            schema = args[i + 1]
    prompt = args[-1] if args else ""
    fresh = answer is not None
    default = "answer" if fresh else "linger"
    fate = _locked(lambda blob: blob["codex"].pop(0) if blob.get("codex") else {"then": default})
    _locked(
        lambda blob: blob.setdefault("codex_lanes" if not fresh else "codex_log", []).append(
            {"argv": args, "cwd": cwd, "model": model, "prompt": prompt, "fate": fate,
             "answer": answer, "schema": schema, "fresh": fresh, "id": None}
        )
    )
    then = fate.get("then", default)
    if schema is not None:
        try:
            json.loads(Path(schema).read_text(encoding="utf-8"))
        except (OSError, ValueError) as error:
            print(f"Output schema file {schema} is not valid JSON: {error}", file=sys.stderr)
            return 1
    if then == "fail" or (then != "linger" and not fresh):
        print(fate.get("stderr", "error: the lane could not start"), file=sys.stderr)
        return 1
    session_id = fate.get("session_id") or (
        str(uuid.uuid4()) if fresh else "01a08000-0000-7000-8000-000000000001"
    )
    _locked(lambda blob: blob["codex_log"][-1].__setitem__("id", session_id) if fresh else None)
    folder = HOME / "sessions" / "2026" / "09" / "08"
    folder.mkdir(parents=True, exist_ok=True)
    rollout = folder / f"rollout-2026-09-08T09-00-00-{session_id}.jsonl"
    meta = {
        "timestamp": _now(),
        "ordinal": 0,
        "type": "session_meta",
        "payload": {
            "session_id": session_id,
            "id": session_id,
            "timestamp": _now(),
            "cwd": cwd or os.getcwd(),
            "originator": "codex_exec",
            "cli_version": "0.153.4",
            "source": "exec",
            "base_instructions": {
                "text": "You are Codex.",
                "provenance": {"type": "model", "model": model or "gpt-6-astra"},
            },
        },
    }
    with rollout.open("a", encoding="utf-8") as f:
        f.write(json.dumps(meta) + "\n")
    _append(rollout, "event_msg", {"type": "task_started", "turn_id": "lane"})
    if fresh and then != "linger":
        time.sleep(float(fate.get("after", 0.3)))
        text = "" if then == "silent" else fate.get("text", "the answer, from the fake worker")
        _append(rollout, "event_msg", {"type": "task_complete", "turn_id": "lane"})
        if answer is not None and text:
            Path(answer).write_text(text, encoding="utf-8")
        print(text)
        return 0
    pid = os.getpid()
    _locked(lambda blob: blob.setdefault("pids", []).append([pid, _proc_start(pid)]))
    # A lane's argv carries no rollout id — `codex exec` takes a brief, not a
    # session — so the runtime finds its process by the rollout it holds
    # open, which is how the real one is found (verified on 0.153.4,
    # 2026-09-08: a live `codex exec` holds its rollout in /proc/<pid>/fd).
    # The handle is made inheritable so it survives the exec below.
    held = os.open(rollout, os.O_WRONLY | os.O_APPEND)
    os.set_inheritable(held, True)
    os.execv("/usr/bin/sleep", [f"codex-exec-lane-{session_id}", "300"])
    return 0


def main(argv: list[str]) -> int:
    if argv[:1] == ["--version"]:
        print("codex-cli 0.153.4 (fake)")
        return 0
    if argv[:1] == ["exec"]:
        rest = argv[1:]
        # `resume` is a subcommand and stands first past the flags; an `exec`
        # without one is a lane. A flag's own value is never read as the
        # subcommand, which is why the flags with values are skipped by name
        # rather than by a leading dash (a brief is a positional too).
        return resume(rest) if _first_positional(rest) == "resume" else lane(rest)
    print(f"fake codex: unsupported {argv}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
