#!/usr/bin/env python3
"""A stand-in for `claude-acct` on the test floor: `best` answers with what
the test put in `$NEEDLE_FAKE_STATE["best"]` and records how it was asked."""

import fcntl
import json
import os
import sys
from pathlib import Path

STATE = Path(os.environ["NEEDLE_FAKE_STATE"])


def main(argv: list[str]) -> int:
    with (STATE.parent / (STATE.name + ".lock")).open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        blob = json.loads(STATE.read_text(encoding="utf-8"))
        blob.setdefault("best_calls", []).append(argv)
        STATE.write_text(json.dumps(blob, indent=1), encoding="utf-8")
        fcntl.flock(lock, fcntl.LOCK_UN)
    if argv[:1] != ["best"]:
        print(f"fake claude-acct: only `best` is played here, not {argv!r}", file=sys.stderr)
        return 2
    answer = blob.get("best")
    if answer is None or "error" in answer:
        print((answer or {}).get("error", "no account with headroom"), file=sys.stderr)
        return 1
    if "--json" in argv:
        print(json.dumps(answer))
    else:
        model = answer.get("model")
        print(answer["slot"] if not model else f"{answer['slot']} --model {model}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
