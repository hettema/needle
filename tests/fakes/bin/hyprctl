#!/usr/bin/env python3
"""A stand-in for `hyprctl` on the test floor: `clients -j` lists the windows
the test (or the fake launcher) put in `$NEEDLE_FAKE_STATE["clients"]`."""

import json
import os
import sys
from pathlib import Path

STATE = Path(os.environ["NEEDLE_FAKE_STATE"])


def main(argv: list[str]) -> int:
    blob = json.loads(STATE.read_text(encoding="utf-8"))
    if argv[:2] == ["clients", "-j"]:
        print(json.dumps(blob.get("clients", [])))
        return 0
    if argv[:1] == ["eval"]:
        print("ok")
        return 0
    print(f"fake hyprctl: {argv!r} is not played here", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
