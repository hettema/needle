#!/usr/bin/env python3
"""A stand-in for `hyprctl` on the test floor: `clients -j` lists the windows
the test (or the fake launcher) put in `$NEEDLE_FAKE_STATE["clients"]`; an
`eval` that focuses a window by address makes it the active one (unless the
test set `focus_works` false), and `activewindow -j` reports it."""

import json
import os
import re
import sys
from pathlib import Path

_FOCUS = re.compile(r"hl\.get_window\('address:(0x[0-9A-Za-z]+)'\)")

STATE = Path(os.environ["NEEDLE_FAKE_STATE"])


def main(argv: list[str]) -> int:
    blob = json.loads(STATE.read_text(encoding="utf-8"))
    if argv[:2] == ["clients", "-j"]:
        print(json.dumps(blob.get("clients", [])))
        return 0
    if argv[:1] == ["eval"]:
        wanted = _FOCUS.search(argv[1] if len(argv) > 1 else "")
        if wanted is not None:
            address = wanted.group(1)
            if not any(c.get("address") == address for c in blob.get("clients", [])):
                print(f"error: no window at {address}")
                return 1
            blob.setdefault("focus_calls", []).append(address)
            blob["active"] = address if blob.get("focus_works", True) else None
            STATE.write_text(json.dumps(blob, indent=1), encoding="utf-8")
        print("ok")
        return 0
    if argv[:2] == ["activewindow", "-j"]:
        active = next(
            (c for c in blob.get("clients", []) if c.get("address") == blob.get("active")), {}
        )
        print(json.dumps(active))
        return 0
    print(f"fake hyprctl: {argv!r} is not played here", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
