#!/usr/bin/env python3
"""A stand-in for `notify-send` on the test floor (card #41): records its
argv under `$NEEDLE_FAKE_STATE["notified"]`, the way the launcher records
a window, and answers the way the real one does with an action — the
action's name on stdout when the test set `press` to it, nothing when the
notification was dismissed. Like the real one it returns only once
answered, which here is at once."""

import fcntl
import json
import os
import sys
from pathlib import Path

STATE = Path(os.environ["NEEDLE_FAKE_STATE"])


def main(argv: list[str]) -> int:
    with (STATE.parent / (STATE.name + ".lock")).open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        blob = json.loads(STATE.read_text(encoding="utf-8"))
        blob.setdefault("notified", []).append(argv)
        STATE.write_text(json.dumps(blob, indent=1), encoding="utf-8")
        fcntl.flock(lock, fcntl.LOCK_UN)
    pressed = blob.get("press")
    actions = [a.split("=", 1)[0] for i, a in enumerate(argv) if i and argv[i - 1] == "-A"]
    if pressed and pressed in actions:
        print(pressed)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
