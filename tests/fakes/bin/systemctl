#!/usr/bin/env python3
"""A stand-in for `systemctl` on the test floor: answers `show` and
`list-units` from the scope properties the test put in
`$NEEDLE_FAKE_STATE["scopes"]`, clears a failed scope on `reset-failed`,
marks one inactive on `stop` (recording it in `scope_stops`, ending no
process; a unit named in `stop_refuses` is refused instead), and
records every call so the test can read what the runtime
asked the user manager."""

import fcntl
import fnmatch
import json
import os
import sys
from pathlib import Path

STATE = Path(os.environ["NEEDLE_FAKE_STATE"])

NOT_SET = "[not set]"


def _default(prop: str, known: bool) -> str:
    if prop == "ActiveState":
        return "inactive"
    if prop == "LoadState":
        return "loaded" if known else "not-found"
    return NOT_SET


def _show(argv: list[str], blob: dict) -> int:
    props: list[str] = []
    units: list[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "-p" and i + 1 < len(argv):
            props.append(argv[i + 1])
            i += 2
            continue
        if not arg.startswith("-") and arg != "show":
            units.append(arg)
        i += 1
    scopes = blob.get("scopes", {})
    blocks: list[str] = []
    for unit in units:
        known = unit in scopes
        values = scopes.get(unit, {})
        lines = [f"Id={unit}"]
        for prop in props:
            if prop == "Id":
                continue
            lines.append(f"{prop}={values.get(prop, _default(prop, known))}")
        blocks.append("\n".join(lines))
    if blocks:
        print("\n\n".join(blocks))
    return 0


def _reset_failed(argv: list[str], blob: dict) -> int:
    units = [a for a in argv if not a.startswith("-") and a != "reset-failed"]
    unit = units[0] if units else ""
    scope = blob.get("scopes", {}).get(unit)
    if scope is not None and scope.get("ActiveState") == "failed":
        scope["ActiveState"] = "inactive"
        scope["LoadState"] = "not-found"
        with (STATE.parent / (STATE.name + ".lock")).open("a+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            STATE.write_text(json.dumps(blob, indent=1), encoding="utf-8")
            fcntl.flock(lock, fcntl.LOCK_UN)
        return 0
    print(
        f"Failed to reset failed state of unit {unit}: Unit {unit} not loaded.",
        file=sys.stderr,
    )
    return 1


def _write(blob: dict) -> None:
    with (STATE.parent / (STATE.name + ".lock")).open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        STATE.write_text(json.dumps(blob, indent=1), encoding="utf-8")
        fcntl.flock(lock, fcntl.LOCK_UN)


def _list_units(argv: list[str], blob: dict) -> int:
    patterns = [a for a in argv if not a.startswith("-") and a != "list-units"]
    wanted = next((a.split("=", 1)[1] for a in argv if a.startswith("--state=")), None)
    for unit, values in blob.get("scopes", {}).items():
        state = values.get("ActiveState", "inactive")
        if wanted and state != wanted:
            continue
        if patterns and not any(fnmatch.fnmatch(unit, p) for p in patterns):
            continue
        sub = "running" if state == "active" else "dead"
        print(f"{unit} loaded {state} {sub} {unit}")
    return 0


def _stop(argv: list[str], blob: dict) -> int:
    units = [a for a in argv if not a.startswith("-") and a != "stop"]
    unit = units[0] if units else ""
    scope = blob.get("scopes", {}).get(unit)
    if scope is None or scope.get("ActiveState") != "active":
        print(f"Failed to stop {unit}: Unit {unit} not loaded.", file=sys.stderr)
        return 5
    if unit in blob.get("stop_refuses", []):
        print(f"Failed to stop {unit}: Access denied", file=sys.stderr)
        return 4
    scope["ActiveState"] = "inactive"
    scope["LoadState"] = "not-found"
    scope.pop("ControlGroup", None)  # a stopped unit has no group any more
    blob.setdefault("scope_stops", []).append(unit)
    _write(blob)
    return 0


def main(argv: list[str]) -> int:
    with (STATE.parent / (STATE.name + ".lock")).open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        blob = json.loads(STATE.read_text(encoding="utf-8"))
        blob.setdefault("systemctl_calls", []).append(argv)
        STATE.write_text(json.dumps(blob, indent=1), encoding="utf-8")
        fcntl.flock(lock, fcntl.LOCK_UN)
    if blob.get("systemctl_fails"):
        print("Failed to connect to bus: No medium found", file=sys.stderr)
        return 1
    if "show" in argv:
        return _show(argv, blob)
    if "reset-failed" in argv:
        return _reset_failed(argv, blob)
    if "list-units" in argv:
        return _list_units(argv, blob)
    if "stop" in argv:
        return _stop(argv, blob)
    print(f"fake systemctl: unsupported: {argv}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
