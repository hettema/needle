#!/usr/bin/env python3
"""A stand-in for `curl` on the test floor: answers a URL from
`$NEEDLE_FAKE_STATE["urls"]` (url → {"code": 200, "body": "..."}) and prints
the body then the status code on its own line, as the runtime asks it to
(`-w '\\n%{http_code}'`). An unknown URL is a connection failure, exit 7."""

import json
import os
import sys
from pathlib import Path

STATE = Path(os.environ["NEEDLE_FAKE_STATE"])


def main(argv: list[str]) -> int:
    blob = json.loads(STATE.read_text(encoding="utf-8"))
    url = argv[-1] if argv else ""
    answer = (blob.get("urls") or {}).get(url)
    if answer is None:
        print(f"curl: (7) Failed to connect to {url}", file=sys.stderr)
        return 7
    sys.stdout.write(str(answer.get("body", "")))
    sys.stdout.write(f"\n{answer.get('code', 200)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
